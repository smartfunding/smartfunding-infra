# .env.example — Valeurs locales SmartFunding (ne jamais committer .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=smartfunding
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:smartfunding@localhost:5432/auth
MONGO_URL=mongodb://localhost:27017/documents
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://smartfunding:smartfunding@localhost:5672
RABBITMQ_UI=http://localhost:15672
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=smartfunding-documents
TEMPORAL_ADDRESS=localhost:7233
ELASTICSEARCH_URL=http://localhost:9200
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
